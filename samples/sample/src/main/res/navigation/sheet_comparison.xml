<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_comparison"
    app:startDestination="@id/comparisonHome">
    <fragment android:id="@+id/comparisonHome" android:name="dev.better.sheet.sample.navigation.ComparisonHomeFragment">
        <action android:id="@+id/openCustomers" app:destination="@id/comparisonCustomers" />
    </fragment>
    <fragment android:id="@+id/comparisonCustomers" android:name="dev.better.sheet.sample.navigation.ComparisonCustomersFragment">
        <action android:id="@+id/openCustomer" app:destination="@id/comparisonCustomer" />
    </fragment>
    <fragment android:id="@+id/comparisonCustomer" android:name="dev.better.sheet.sample.navigation.ComparisonCustomerFragment" />
    <fragment android:id="@+id/comparisonReceipt" android:name="dev.better.sheet.sample.navigation.ComparisonReceiptFragment" />
    <dialog android:id="@+id/legacyCustomerSheet" android:name="dev.better.sheet.sample.navigation.LegacyCustomerSheetFragment">
        <argument android:name="customer" app:argType="string" android:defaultValue="Alex Rivera" />
    </dialog>
    <sheet android:id="@+id/modalCustomerSheet" android:name="dev.better.sheet.sample.navigation.ModalCustomerSheetFragment">
        <argument android:name="customer" app:argType="string" android:defaultValue="Alex Rivera" />
        <argument android:name="depth" app:argType="integer" android:defaultValue="1" />
    </sheet>
    <action android:id="@+id/openLegacySheet" app:destination="@id/legacyCustomerSheet" />
    <action android:id="@+id/openModalSheet" app:destination="@id/modalCustomerSheet" />
    <action android:id="@+id/openReceipt" app:destination="@id/comparisonReceipt" />
</navigation>
